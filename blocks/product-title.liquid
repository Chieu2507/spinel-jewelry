{% # theme-check-disable ValidScopedCSSClass %}
{% assign card_product = closest.product | default: product %}
{% if card_product != blank %}<{{ block.settings.html_tag | default: 'h3' }} class="editorial-hero__product-title spinel-heading--{{ block.settings.heading_size | default: 'h5' }}" {{ block.shopify_attributes }}>{{ card_product.title | escape }}</{{ block.settings.html_tag | default: 'h3' }}>{% endif %}
{% schema %}{"name":"Product title","settings":[{"type":"header","content":"Product title"},{"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"h1","label":"XX-large"},{"value":"h2","label":"X-large"},{"value":"h3","label":"Large"},{"value":"h4","label":"Medium"},{"value":"h5","label":"Small"},{"value":"h6","label":"X-small"}],"default":"h5"},{"type":"select","id":"html_tag","label":"HTML Tag","options":[{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"},{"value":"h5","label":"H5"},{"value":"h6","label":"H6"}],"default":"h3"}],"presets":[{"name":"Product title"}]}{% endschema %}
