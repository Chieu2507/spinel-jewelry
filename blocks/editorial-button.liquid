{% if block.settings.label != blank and block.settings.link != blank %}<a class="button button--tertiary editorial-hero__link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}<span aria-hidden="true">→</span></a>{% endif %}
{% schema %}{"name":"Button","settings":[{"type":"header","content":"Button"},{"type":"text","id":"label","label":"Label","default":"Begin your selection"},{"type":"url","id":"link","label":"Link"}]}{% endschema %}
