{% liquid
  assign card_product = closest.product | default: product
%}

<article
  class="editorial-hero__product editorial-hero__product--border-{{ block.settings.border_style }}"
  data-product-card
  style="--product-card-gap: {{ block.settings.vertical_gap }}px; --product-card-background: {{ block.settings.background_color | default: 'rgb(255 255 255 / 92%)' }}; --product-card-radius: {{ block.settings.corner_radius }}px; --product-card-padding-top: {{ block.settings.padding_top }}px; --product-card-padding-bottom: {{ block.settings.padding_bottom }}px; --product-card-padding-left: {{ block.settings.padding_left }}px; --product-card-padding-right: {{ block.settings.padding_right }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks', closest.product: card_product %}
</article>

{% schema %}
{
  "name": "Product card",
  "blocks": [
    { "type": "product-card-media" },
    { "type": "product-title" },
    { "type": "product-vendor" },
    { "type": "product-price" },
    { "type": "product-badges" },
    { "type": "product-rating" },
    { "type": "spacer" }
  ],
  "settings": [
    { "type": "paragraph", "content": "Displays product from parent section" },
    { "type": "range", "id": "vertical_gap", "label": "Vertical gap", "min": 0, "max": 48, "step": 1, "unit": "px", "default": 4 },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "header", "content": "Borders" },
    { "type": "select", "id": "border_style", "label": "Style", "options": [{ "value": "none", "label": "None" }, { "value": "solid", "label": "Solid" }], "default": "none" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0 },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_left", "label": "Left", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_right", "label": "Right", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 18 }
  ],
  "presets": [
    {
      "name": "Product card",
      "blocks": [
        { "type": "product-card-media" },
        { "type": "product-title" },
        { "type": "product-vendor" },
        { "type": "spacer" },
        { "type": "product-price" },
        { "type": "product-badges" },
        { "type": "product-rating" }
      ]
    }
  ]
}
{% endschema %}
