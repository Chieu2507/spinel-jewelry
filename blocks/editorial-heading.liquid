{% if block.settings.heading != blank %}<{{ block.settings.heading_tag | default: 'h1' }} id="EditorialHero-{{ section.id }}" class="editorial-hero__heading spinel-heading--{{ block.settings.heading_size | default: 'h1' }} editorial-hero__heading--{{ block.settings.alignment | default: 'left' }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</{{ block.settings.heading_tag | default: 'h1' }}>{% endif %}
{% schema %}{"name":"Heading","settings":[{"type":"header","content":"Heading"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Jewelry, chosen like it <em>matters.</em>"},{"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"h1","label":"XX-large"},{"value":"h2","label":"X-large"},{"value":"h3","label":"Large"},{"value":"h4","label":"Medium"},{"value":"h5","label":"Small"},{"value":"h6","label":"X-small"}],"default":"h1"},{"type":"select","id":"heading_tag","label":"HTML Tag","options":[{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"},{"value":"h5","label":"H5"},{"value":"h6","label":"H6"}],"default":"h1"},{"type":"text_alignment","id":"alignment","label":"Alignment","default":"left"}]}{% endschema %}
