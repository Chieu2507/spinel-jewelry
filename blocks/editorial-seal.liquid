{% if block.settings.image != blank %}<div class="editorial-hero__seal{% if block.settings.enable_rotation %} editorial-hero__seal--rotating editorial-hero__seal--{{ block.settings.rotation_direction }}{% endif %}" style="--seal-size-desktop: {{ block.settings.size_desktop }}px; --seal-size-mobile: {{ block.settings.size_mobile }}px; --seal-rotation-duration: {{ block.settings.rotation_duration }}s;" {{ block.shopify_attributes }}>{% render 'responsive-image', image: block.settings.image, max_width: 320, widths: '160, 240, 320', sizes: '160px', class: 'editorial-hero__seal-image', loading: 'lazy', decorative: true %}</div>{% endif %}
{% schema %}{"name":"Seal","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"range","id":"size_desktop","label":"Desktop size","min":64,"max":280,"step":4,"unit":"px","default":160},{"type":"range","id":"size_mobile","label":"Mobile size","min":40,"max":160,"step":4,"unit":"px","default":68},{"type":"checkbox","id":"enable_rotation","label":"Enable rotation","default":true},{"type":"select","id":"rotation_direction","label":"Rotation direction","options":[{"value":"clockwise","label":"Clockwise"},{"value":"counterclockwise","label":"Counter-clockwise"}],"default":"clockwise","visible_if":"{{ block.settings.enable_rotation }}"},{"type":"range","id":"rotation_duration","label":"Rotation speed","min":8,"max":60,"step":1,"unit":"s","default":18,"visible_if":"{{ block.settings.enable_rotation }}"}]}{% endschema %}
